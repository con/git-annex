-- cabal.project file that is equivilant to building with stack.yaml,
-- with package versions from stackage.
packages:
  .
jobs: $ncpus
semaphore: True
import: cabal-stackage.config
constraints: blake3 ==0.3, libmagic ==1.3.2, ram ==0.22.0, botan-low ==0.2.0.1, botan-bindings ==0.3.0.0
flags: +Botan +MagicMime +Blake3 +XXH3 +OsPath +Dbus
